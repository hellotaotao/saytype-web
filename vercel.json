{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["iad1"],
  "functions": {
    "api/polish.js": { "maxDuration": 15 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "saytype.taotao.au" }],
      "destination": "https://typealoud.app/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/v1/polish", "destination": "/api/polish" },
    {
      "source": "/download/:path*",
      "destination": "https://649ogrnzpi9dgfiw.public.blob.vercel-storage.com/:path*"
    }
  ]
}
